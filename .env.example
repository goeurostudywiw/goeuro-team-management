# ==============================================================================
# GOEURO EDUCATION AGENCY — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. DATABASE CONFIGURATION
# Default: Local persistent SQLite (recommended for single-server VPS & Docker)
DATABASE_URL="file:./dev.db"

# Optional: Production PostgreSQL (for multi-server high-scale deployments)
# DATABASE_URL="postgresql://username:password@db-host:5432/goeuro_db?schema=public"

# 2. PUBLIC APPLICATION URL (Must use HTTPS on public domains for camera/mic access!)
# Local development:
# NEXT_PUBLIC_APP_URL="http://localhost:3005"
# Production example:
NEXT_PUBLIC_APP_URL="https://counseling.goeuro.agency"

# 3. WEBRTC STUN/TURN SERVERS (For NAT & Myanmar Mobile Telecom Traversal)
# Default: Google Public STUN ($0.00 Free)
# For strict mobile carrier symmetric NATs (e.g. MPT/Ooredoo/Atom), add free Metered TURN credentials:
# NEXT_PUBLIC_ICE_SERVERS='[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:openrelay.metered.ca:80","username":"openrelayproject","credential":"openrelayproject"},{"urls":"turn:openrelay.metered.ca:443","username":"openrelayproject","credential":"openrelayproject"}]'

# 4. OPTIONAL S3 / CLOUDFLARE R2 OBJECT STORAGE (For Infinite Cloud Storage with $0 Egress)
# S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
# S3_ACCESS_KEY_ID="your-access-key-id"
# S3_SECRET_ACCESS_KEY="your-secret-access-key"
# S3_BUCKET_NAME="goeuro-recordings"
# S3_PUBLIC_DOMAIN="https://recordings.goeuro.agency"
